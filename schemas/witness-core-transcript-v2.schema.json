{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/witness-core-transcript-v2.schema.json",
  "title": "WitnessCoreTranscriptV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_commit", "run_id", "version", "protocol",
    "verified_at", "environment",
    "actors_simulated", "input_mode", "verification_anchor", "package",
    "release_anchor", "bootstrap", "chain", "pilot_invite_hash",
    "trust_policy_hash", "public_service", "signer_evidence",
    "participant_attestations", "session", "events", "artifacts", "network_tasks",
    "observation_receipts", "observation_set", "evidence_bundle", "dispute",
    "review_receipts", "proposal_gate", "metrics", "faults", "acceptance",
    "does_not_prove", "transcript_hash"
  ],
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "bytes32": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uint": {"type": "string", "pattern": "^[0-9]+$"}
  },
  "properties": {
    "schema_version": {"const": "loveengine.witness-core-transcript/2"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "protocol": {"const": "loveengine-witness-net/0.6"},
    "verified_at": {"$ref": "#/$defs/uint"},
    "environment": {"enum": ["local_anvil", "sepolia_invited_pilot"]},
    "actors_simulated": {"type": "boolean"},
    "input_mode": {"enum": ["synthetic_fixture", "invited_operator_input"]},
    "verification_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_number", "block_hash", "timestamp", "selected_via"],
      "properties": {
        "block_number": {"$ref": "#/$defs/uint"},
        "block_hash": {"$ref": "#/$defs/bytes32"},
        "timestamp": {"$ref": "#/$defs/uint"},
        "selected_via": {"enum": ["latest", "safe"]}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive", "archive_sha256", "archive_keccak256", "manifest_hash"],
      "properties": {
        "archive": {"type": "string", "minLength": 1},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "archive_keccak256": {"$ref": "#/$defs/bytes32"},
        "manifest_hash": {"$ref": "#/$defs/bytes32"}
      }
    },
    "release_anchor": {"type": "object"},
    "bootstrap": {"type": "object"},
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id", "registry", "publisher", "deployment_transaction",
        "runtime_code_hash", "release_transaction", "release_status",
        "primary_rpc_observation_hash", "secondary_rpc_observation_hash"
      ],
      "properties": {
        "chain_id": {"$ref": "#/$defs/uint"},
        "registry": {"$ref": "#/$defs/address"},
        "publisher": {"$ref": "#/$defs/address"},
        "deployment_transaction": {"$ref": "#/$defs/bytes32"},
        "runtime_code_hash": {"$ref": "#/$defs/bytes32"},
        "release_transaction": {"$ref": "#/$defs/bytes32"},
        "release_status": {"const": "active"},
        "primary_rpc_observation_hash": {"$ref": "#/$defs/sha256"},
        "secondary_rpc_observation_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "pilot_invite_hash": {"$ref": "#/$defs/sha256"},
    "trust_policy_hash": {"$ref": "#/$defs/sha256"},
    "public_service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "transport", "participant_origin", "relay_url",
        "tailnet_only", "funnel_enabled", "admin_surface",
        "participant_allowlist_hash", "tailscale_serve_config_hash",
        "restore_verified", "config_hash"
      ],
      "properties": {
        "schema_version": {"const": "loveengine.invited-pilot-service-config/1"},
        "transport": {"enum": ["loopback", "tailscale_serve"]},
        "participant_origin": {"type": "string", "pattern": "^https?://"},
        "relay_url": {"type": "string", "pattern": "^wss?://"},
        "tailnet_only": {"type": "boolean"},
        "funnel_enabled": {"const": false},
        "admin_surface": {"const": "loopback_only"},
        "participant_allowlist_hash": {"$ref": "#/$defs/bytes32"},
        "tailscale_serve_config_hash": {"$ref": "#/$defs/bytes32"},
        "restore_verified": {"const": true},
        "config_hash": {"$ref": "#/$defs/bytes32"}
      }
    },
    "signer_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address", "roles", "backend", "approval_mode", "ruleset_sha256",
          "rules_attestation_sha256", "audit_log_sha256"
        ],
        "properties": {
          "address": {"$ref": "#/$defs/address"},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["publisher", "task_issuer", "node"]}
          },
          "backend": {"enum": ["clef", "anvil-test"]},
          "approval_mode": {"enum": ["manual_confirm", "unlocked_test"]},
          "ruleset_sha256": {"$ref": "#/$defs/sha256"},
          "rules_attestation_sha256": {"$ref": "#/$defs/sha256"},
          "audit_log_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "participant_attestations": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "object"}
    },
    "session": {"type": "object"},
    "events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_hash", "size"],
        "properties": {
          "artifact_hash": {"$ref": "#/$defs/sha256"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "network_tasks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "observation_receipts": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "observation_set": {"type": "object"},
    "evidence_bundle": {"type": "object"},
    "dispute": {"type": "object"},
    "review_receipts": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "proposal_gate": {"type": "object"},
    "metrics": {"type": "object"},
    "faults": {"type": "object"},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds", "event_count", "observer_count",
        "restart_verified", "reconnect_verified", "cleanup_verified",
        "secret_findings", "stderr_empty"
      ],
      "properties": {
        "duration_seconds": {"const": 900},
        "event_count": {"const": 30},
        "observer_count": {"const": 10},
        "restart_verified": {"type": "boolean"},
        "reconnect_verified": {"type": "boolean"},
        "cleanup_verified": {"type": "boolean"},
        "secret_findings": {"const": 0},
        "stderr_empty": {"type": "boolean"}
      }
    },
    "does_not_prove": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "content_truth",
          "participant_independence",
          "production_availability",
          "enterprise_identity",
          "signer_backend_or_rules_enforcement",
          "tailscale_configuration_authenticity"
        ]
      }
    },
    "transcript_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"environment": {"const": "sepolia_invited_pilot"}},
        "required": ["environment"]
      },
      "then": {
        "properties": {
          "verification_anchor": {
            "properties": {"selected_via": {"const": "safe"}}
          },
          "chain": {
            "properties": {"chain_id": {"const": "11155111"}}
          },
          "public_service": {
            "properties": {
              "transport": {"const": "tailscale_serve"},
              "participant_origin": {"pattern": "^https://"},
              "relay_url": {"pattern": "^wss://"},
              "tailnet_only": {"const": true}
            }
          },
          "signer_evidence": {
            "items": {
              "properties": {
                "backend": {"const": "clef"},
                "approval_mode": {"const": "manual_confirm"}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"environment": {"const": "local_anvil"}},
        "required": ["environment"]
      },
      "then": {
        "properties": {
          "verification_anchor": {
            "properties": {"selected_via": {"const": "latest"}}
          },
          "public_service": {
            "properties": {"transport": {"const": "loopback"}}
          },
          "signer_evidence": {
            "items": {
              "properties": {
                "backend": {"const": "anvil-test"},
                "approval_mode": {"const": "unlocked_test"}
              }
            }
          }
        }
      }
    }
  ]
}
