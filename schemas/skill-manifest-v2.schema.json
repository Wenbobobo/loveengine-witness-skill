{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/skill-manifest-v2.schema.json",
  "title": "SkillManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "version",
    "status",
    "protocol",
    "source_refs",
    "source_hashes",
    "commands",
    "contracts",
    "eip712",
    "evidence",
    "security",
    "package_hash"
  ],
  "properties": {
    "schema_version": {"const": "loveengine.skill-manifest/0.2"},
    "skill_id": {"const": "loveengine-witness"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "deprecated"]},
    "protocol": {"const": "loveengine-witness-net/0.2"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "commands": {"type": "object"},
    "contracts": {"type": "object"},
    "eip712": {"type": "object"},
    "evidence": {"type": "object"},
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_keys_in_agent_context"],
      "properties": {
        "private_keys_in_agent_context": {"const": false}
      }
    },
    "package_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
