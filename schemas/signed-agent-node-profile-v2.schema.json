{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/signed-agent-node-profile-v2.schema.json",
  "title": "SignedAgentNodeProfileV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chain_id", "registry", "profile", "signature"],
  "properties": {
    "schema_version": {"const": "loveengine.signed-agent-node-profile/2"},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "registry": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "capabilities", "sequence", "valid_until"],
      "properties": {
        "node": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["observe_live_text", "review_dispute"]}},
        "sequence": {"type": "string", "pattern": "^[0-9]+$"},
        "valid_until": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "signature": {"type": "string", "pattern": "^0x[0-9a-fA-F]{130}$"}
  }
}
