{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/agent-node-profile-v2.schema.json",
  "title": "AgentNodeProfileV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "agent_runtime",
    "skill_id",
    "skill_version",
    "address",
    "signer_type",
    "capabilities",
    "network_endpoints",
    "private_key_available_to_agent",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": "loveengine.agent-node-profile/0.2"},
    "node_id": {"type": "string", "minLength": 1},
    "agent_runtime": {"type": "string", "minLength": 1},
    "skill_id": {"const": "loveengine-witness"},
    "skill_version": {"type": "string", "minLength": 1},
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "signer_type": {
      "enum": ["clef", "cast", "browser_wallet", "aa", "anvil-test"]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "network_endpoints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "availability": {"type": "object"},
    "private_key_available_to_agent": {"const": false},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_request_signature",
        "can_submit_transaction",
        "can_modify_source_materials"
      ],
      "properties": {
        "can_request_signature": {"type": "boolean"},
        "can_submit_transaction": {"type": "boolean"},
        "can_modify_source_materials": {"const": false}
      }
    }
  }
}
