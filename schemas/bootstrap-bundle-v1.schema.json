{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/bootstrap-bundle-v1.schema.json",
  "title": "BootstrapBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chain_id", "registry", "publisher", "directory", "directory_hash", "sequence", "valid_until", "signature"],
  "properties": {
    "schema_version": {"const": "loveengine.bootstrap-bundle/1"},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "registry": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "publisher": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "directory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "chain_id", "registry", "profile", "signature"]
      }
    },
    "directory_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "sequence": {"type": "string", "pattern": "^[0-9]+$"},
    "valid_until": {"type": "string", "pattern": "^[0-9]+$"},
    "signature": {"type": "string", "pattern": "^0x[0-9a-fA-F]{130}$"}
  }
}
