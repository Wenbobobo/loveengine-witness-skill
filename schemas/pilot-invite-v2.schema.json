{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/pilot-invite-v2.schema.json",
  "title": "PilotInviteV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "participant_url",
    "dashboard_url",
    "relay_url",
    "chain_id",
    "registry",
    "publisher",
    "skill_id",
    "version",
    "package_hash",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "loveengine.pilot-invite/2"},
    "participant_url": {"type": "string", "pattern": "^https?://"},
    "dashboard_url": {"type": "string", "pattern": "^https?://"},
    "relay_url": {"type": "string", "pattern": "^wss?://"},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "registry": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "publisher": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "skill_id": {"const": "loveengine-witness"},
    "version": {"type": "string", "minLength": 1},
    "package_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "expires_at": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
  },
  "allOf": [
    {
      "if": {"properties": {"chain_id": {"const": "11155111"}}},
      "then": {
        "properties": {
          "participant_url": {"pattern": "^https://[^/]+\\.ts\\.net$"},
          "dashboard_url": {"pattern": "^https://[^/]+\\.ts\\.net/demo/$"},
          "relay_url": {"pattern": "^wss://[^/]+\\.ts\\.net/v1/ws$"}
        }
      }
    },
    {
      "if": {"properties": {"chain_id": {"const": "31337"}}},
      "then": {
        "properties": {
          "participant_url": {"pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+$"},
          "dashboard_url": {"pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+/demo/$"},
          "relay_url": {"pattern": "^ws://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+/v1/ws$"}
        }
      }
    }
  ]
}
