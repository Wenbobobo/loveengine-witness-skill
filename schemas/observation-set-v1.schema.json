{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/observation-set-v1.schema.json",
  "title": "ObservationSetV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "event_count", "head_event_hash", "bundle_hash", "node_count", "receipts", "observation_set_hash"],
  "properties": {
    "schema_version": {"const": "loveengine.observation-set/1"},
    "session_id": {"type": "string", "minLength": 1},
    "event_count": {"type": "string", "pattern": "^[0-9]+$"},
    "head_event_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "bundle_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "node_count": {"const": "3"},
    "receipts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "object"}
    },
    "observation_set_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}
  }
}
