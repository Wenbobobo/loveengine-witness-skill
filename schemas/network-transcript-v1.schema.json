{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/network-transcript-v1.schema.json",
  "title": "NetworkTranscriptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "chain_id", "contracts", "release", "bootstrap", "nodes", "tasks", "receipts", "metrics", "node_processes", "recovery", "transcript_hash"],
  "properties": {
    "schema_version": {"const": "loveengine.network-transcript/1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "contracts": {"type": "object"},
    "release": {"type": "object"},
    "bootstrap": {"type": "object"},
    "nodes": {"type": "array", "minItems": 3},
    "tasks": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "receipts": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "metrics": {"type": "object"},
    "node_processes": {"const": 3},
    "recovery": {"type": "object"},
    "transcript_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
