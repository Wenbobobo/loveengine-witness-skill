{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/pilot-invite-v1.schema.json",
  "title": "PilotInviteV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "server_url",
    "operator_url",
    "dashboard_url",
    "relay_url",
    "chain_id",
    "registry",
    "publisher",
    "skill_id",
    "version",
    "package_hash"
  ],
  "properties": {
    "schema_version": {"const": "loveengine.pilot-invite/1"},
    "server_url": {"type": "string", "pattern": "^https?://"},
    "operator_url": {"type": "string", "pattern": "^https?://"},
    "dashboard_url": {"type": "string", "pattern": "^https?://"},
    "relay_url": {"type": "string", "pattern": "^https?://"},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "registry": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "publisher": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "skill_id": {"const": "loveengine-witness"},
    "version": {"type": "string", "minLength": 1},
    "package_hash": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|0x[0-9a-fA-F]{64})$"
    }
  }
}
