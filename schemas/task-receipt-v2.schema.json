{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/task-receipt-v2.schema.json",
  "title": "TaskReceiptV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chain_id", "registry", "task_id", "node", "status", "result", "result_hash", "nonce", "completed_at", "signature"],
  "properties": {
    "schema_version": {"const": "loveengine.task-receipt/2"},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "registry": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "task_id": {"type": "string", "minLength": 1},
    "node": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "status": {"enum": ["completed", "rejected"]},
    "result": {"type": "object"},
    "result_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "nonce": {"type": "string", "pattern": "^[0-9]+$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]+$"},
    "signature": {"type": "string", "pattern": "^0x[0-9a-fA-F]{130}$"}
  }
}
