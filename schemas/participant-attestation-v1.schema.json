{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/participant-attestation-v1.schema.json",
  "title": "ParticipantAttestationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "chain_id", "registry", "run_id", "node", "role",
    "profile_hash", "assignment_task_id", "assignment_payload_hash",
    "pilot_invite_hash", "trust_policy_hash",
    "package_hash", "manifest_hash", "service_config_hash", "ruleset_sha256",
    "rules_attestation_sha256",
    "operator_group_hash", "network_group_hash", "issued_at", "valid_until",
    "signature"
  ],
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "bytes32": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uint": {"type": "string", "pattern": "^[0-9]+$"}
  },
  "properties": {
    "schema_version": {"const": "loveengine.participant-attestation/1"},
    "chain_id": {"$ref": "#/$defs/uint"},
    "registry": {"$ref": "#/$defs/address"},
    "run_id": {"type": "string", "minLength": 1},
    "node": {"$ref": "#/$defs/address"},
    "role": {"const": "observation_node"},
    "profile_hash": {"$ref": "#/$defs/bytes32"},
    "assignment_task_id": {"type": "string", "minLength": 1},
    "assignment_payload_hash": {"$ref": "#/$defs/bytes32"},
    "pilot_invite_hash": {"$ref": "#/$defs/sha256"},
    "trust_policy_hash": {"$ref": "#/$defs/sha256"},
    "package_hash": {"$ref": "#/$defs/bytes32"},
    "manifest_hash": {"$ref": "#/$defs/bytes32"},
    "service_config_hash": {"$ref": "#/$defs/bytes32"},
    "ruleset_sha256": {"$ref": "#/$defs/sha256"},
    "rules_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "operator_group_hash": {"$ref": "#/$defs/bytes32"},
    "network_group_hash": {"$ref": "#/$defs/bytes32"},
    "issued_at": {"$ref": "#/$defs/uint"},
    "valid_until": {"$ref": "#/$defs/uint"},
    "signature": {"type": "string", "pattern": "^0x[0-9a-fA-F]{130}$"}
  }
}
