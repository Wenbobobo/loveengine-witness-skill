{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/signed-chain-transaction-v1.schema.json",
  "title": "SignedChainTransactionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_hash",
    "request_hash",
    "signer",
    "signed_at",
    "raw_transaction",
    "transaction_hash",
    "authorization_typed_data_sha256",
    "authorization_signature"
  ],
  "properties": {
    "schema_version": {"const": "loveengine.signed-chain-transaction/1"},
    "plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signer": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "signed_at": {"type": "string", "pattern": "^[0-9]+$"},
    "raw_transaction": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
    "transaction_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "authorization_typed_data_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authorization_signature": {"type": "string", "pattern": "^0x[0-9a-fA-F]{130}$"}
  }
}
