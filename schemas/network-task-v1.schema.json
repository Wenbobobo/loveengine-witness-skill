{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/network-task-v1.schema.json",
  "title": "NetworkTaskV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chain_id", "registry", "task_id", "task_type", "issuer", "recipient", "manifest_hash", "payload", "payload_hash", "nonce", "deadline", "signature"],
  "properties": {
    "schema_version": {"const": "loveengine.network-task/1"},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "registry": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["propagate_skill", "observe_broadcast"]},
    "issuer": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "recipient": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "manifest_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "payload": {"type": "object"},
    "payload_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "nonce": {"type": "string", "pattern": "^[0-9]+$"},
    "deadline": {"type": "string", "pattern": "^[0-9]+$"},
    "signature": {"type": "string", "pattern": "^0x[0-9a-fA-F]{130}$"}
  }
}
