{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/pilot-config-v2.schema.json",
  "title": "PilotConfigV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "admin",
    "participant",
    "database",
    "relay_database",
    "artifact_root",
    "audit_log",
    "token_file",
    "bootstrap_file",
    "release_file",
    "package_archive",
    "chain_id"
  ],
  "properties": {
    "schema_version": {"const": "loveengine.pilot-config/2"},
    "run_id": {"type": "string", "minLength": 1},
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "allowed_origins"],
      "properties": {
        "host": {"enum": ["127.0.0.1", "::1"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "allowed_origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https?://"}
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "public_base_url"],
      "properties": {
        "host": {"const": "127.0.0.1"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "public_base_url": {"type": "string", "pattern": "^https?://"}
      }
    },
    "database": {"type": "string", "minLength": 1},
    "relay_database": {"type": "string", "minLength": 1},
    "artifact_root": {"type": "string", "minLength": 1},
    "audit_log": {"type": "string", "minLength": 1},
    "token_file": {"type": "string", "minLength": 1},
    "bootstrap_file": {"type": "string", "minLength": 1},
    "release_file": {"type": "string", "minLength": 1},
    "package_archive": {"type": "string", "minLength": 1},
    "rpc_url": {"type": "string", "pattern": "^https?://"},
    "rpc_url_file": {"type": "string", "minLength": 1},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"}
  },
  "oneOf": [
    {
      "required": ["rpc_url"],
      "not": {"required": ["rpc_url_file"]}
    },
    {
      "required": ["rpc_url_file"],
      "not": {"required": ["rpc_url"]}
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"chain_id": {"const": "11155111"}}},
      "then": {
        "required": ["rpc_url_file"],
        "not": {"required": ["rpc_url"]},
        "properties": {
          "participant": {
            "properties": {
              "public_base_url": {"pattern": "^https://[^/]+\\.ts\\.net$"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"chain_id": {"const": "31337"}}},
      "then": {
        "properties": {
          "participant": {
            "properties": {
              "public_base_url": {"pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+$"}
            }
          }
        }
      }
    }
  ]
}
