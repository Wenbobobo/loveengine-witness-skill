{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/live-review-transcript-v1.schema.json",
  "title": "LiveReviewTranscriptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "chain_id", "contracts", "bootstrap", "session", "events", "evidence_bundle", "nodes", "tasks", "reviews", "disputes", "proposal_gate", "metrics", "transcript_hash"],
  "properties": {
    "schema_version": {"const": "loveengine.live-review-transcript/1"},
    "run_id": {"type": "string", "minLength": 1},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "contracts": {"type": "object"},
    "bootstrap": {"type": "object"},
    "session": {"type": "object"},
    "events": {"type": "array"},
    "evidence_bundle": {"type": "object"},
    "nodes": {"type": "array", "minItems": 3},
    "tasks": {"type": "array"},
    "reviews": {"type": "array"},
    "disputes": {"type": "array"},
    "proposal_gate": {"type": "object"},
    "metrics": {"type": "object"},
    "transcript_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "not": {"$ref": "#/$defs/secret"},
  "$defs": {
    "secret": {
      "type": "object",
      "anyOf": [
        {"required": ["private_key"]},
        {"required": ["mnemonic"]},
        {"required": ["keystore"]},
        {"required": ["token"]}
      ]
    }
  }
}
