{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/external-signer-config-v1.schema.json",
  "title": "ExternalSignerConfigV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "role",
    "address",
    "chain_id",
    "approval_mode",
    "request_timeout_seconds",
    "transport",
    "endpoint",
    "ruleset_sha256",
    "rules_attestation_sha256",
    "allowed_typed_data",
    "approved_transaction_request_hashes"
  ],
  "properties": {
    "schema_version": {"const": "loveengine.external-signer-config/1"},
    "kind": {"enum": ["anvil_rpc", "clef"]},
    "role": {
      "enum": ["publisher", "task_issuer", "observation_node", "voting_witness"]
    },
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "approval_mode": {"enum": ["manual_confirm", "unlocked_test"]},
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "transport": {"enum": ["http", "ipc"]},
    "endpoint": {"type": "string", "minLength": 1, "maxLength": 4096},
    "ruleset_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rules_attestation_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "allowed_typed_data": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain_name",
          "domain_version",
          "verifying_contract",
          "primary_type"
        ],
        "properties": {
          "domain_name": {"type": "string", "minLength": 1},
          "domain_version": {"type": "string", "minLength": 1},
          "verifying_contract": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "primary_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "approved_transaction_request_hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "clef"}}},
      "then": {
        "properties": {
          "approval_mode": {"const": "manual_confirm"},
          "request_timeout_seconds": {"minimum": 30}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "anvil_rpc"}}},
      "then": {
        "properties": {
          "approval_mode": {"const": "unlocked_test"},
          "request_timeout_seconds": {"maximum": 30}
        }
      }
    }
  ]
}
