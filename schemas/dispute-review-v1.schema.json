{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/dispute-review-v1.schema.json",
  "title": "DisputeReviewV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "dispute_id", "bundle_hash", "node", "verdict", "reason_hash", "completed_at", "signature"],
  "properties": {
    "schema_version": {"const": "loveengine.dispute-review/1"},
    "review_id": {"type": "string", "minLength": 1},
    "dispute_id": {"type": "string", "minLength": 1},
    "bundle_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "node": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "verdict": {"enum": ["uphold", "dismiss", "unable_to_determine"]},
    "reason_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]+$"},
    "signature": {"type": "string", "pattern": "^0x([0-9a-fA-F]{130})?$"}
  }
}
