{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/node-trust-policy-v1.schema.json",
  "title": "NodeTrustPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chain_id",
    "registry",
    "publisher",
    "skill_id",
    "version",
    "package_hash",
    "manifest_hash",
    "allowed_issuers"
  ],
  "properties": {
    "schema_version": {"const": "loveengine.node-trust-policy/1"},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "registry": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "publisher": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "skill_id": {"const": "loveengine-witness"},
    "version": {"type": "string", "minLength": 1},
    "package_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "allowed_issuers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}
    }
  }
}
