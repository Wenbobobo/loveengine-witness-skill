{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/skill-manifest-v3.schema.json",
  "title": "SkillManifestV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "version",
    "status",
    "protocol",
    "source_refs",
    "source_hashes",
    "commands",
    "contracts",
    "registry_binding",
    "network",
    "eip712",
    "evidence",
    "security",
    "distribution",
    "package_hash"
  ],
  "properties": {
    "schema_version": {"const": "loveengine.skill-manifest/0.3"},
    "skill_id": {"const": "loveengine-witness"},
    "version": {"enum": ["0.3.0-network-pilot", "0.3.1-demo-ready", "0.4.0-live-evidence-pilot", "0.5.0-lan-pilot", "0.6.0-contract-public-pilot", "0.6.1-contract-public-pilot"]},
    "status": {"const": "pilot"},
    "protocol": {"enum": ["loveengine-witness-net/0.3", "loveengine-witness-net/0.4", "loveengine-witness-net/0.5", "loveengine-witness-net/0.6"]},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "commands": {"type": "object", "minProperties": 1},
    "contracts": {
      "type": "object",
      "required": ["WitnessDAO", "CorporateSink", "StreamingEngine", "PublicSink", "SkillRegistry"]
    },
    "registry_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "address", "publisher", "skill_id_hash", "version_hash", "package_hash_source", "package_hash_algorithm", "environment"],
      "properties": {
        "chain_id": {"const": "31337"},
        "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "publisher": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "skill_id_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
        "version_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
        "package_hash_source": {"const": "SkillRegistry.Release.packageHash"},
        "package_hash_algorithm": {"const": "keccak256"},
        "environment": {"const": "anvil-only"}
      }
    },
    "network": {
      "type": "object",
      "required": ["task_types", "delivery", "transport", "relay_is_trust_root", "end_to_end_encryption"],
      "properties": {
        "task_types": {
          "type": "array",
          "items": {"enum": ["propagate_skill", "observe_broadcast", "observe_live_text", "review_dispute"]},
          "uniqueItems": true,
          "minItems": 2
        },
        "delivery": {"const": "at-least-once"},
        "transport": {"const": "outbound-websocket"},
        "relay_is_trust_root": {"const": false},
        "end_to_end_encryption": {"const": false}
      }
    },
    "eip712": {"type": "object"},
    "evidence": {"type": "object"},
    "security": {
      "type": "object",
      "required": ["private_keys_in_agent_context", "private_keys_in_cli_arguments", "private_keys_in_transcripts", "vote_signing_tasks_allowed"],
      "properties": {
        "private_keys_in_agent_context": {"const": false},
        "private_keys_in_cli_arguments": {"const": false},
        "private_keys_in_transcripts": {"const": false},
        "vote_signing_tasks_allowed": {"const": false}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_format", "deterministic", "checksums", "sbom", "registry_hash"],
      "properties": {
        "archive_format": {"const": "zip"},
        "deterministic": {"const": true},
        "checksums": {"const": "checksums.json"},
        "sbom": {"const": "sbom.spdx.json"},
        "registry_hash": {"const": "keccak256(actual_zip_bytes)"}
      }
    },
    "package_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
