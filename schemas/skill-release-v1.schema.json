{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loveengine.local/schemas/skill-release-v1.schema.json",
  "title": "SkillReleaseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chain_id", "registry", "publisher", "skill_id", "version", "version_hash", "package_hash", "manifest_hash", "previous_version_hash", "status"],
  "properties": {
    "schema_version": {"const": "loveengine.skill-release/1"},
    "chain_id": {"type": "string", "pattern": "^[0-9]+$"},
    "registry": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "publisher": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "skill_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "version_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "package_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "previous_version_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "replacement_version_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "status": {"enum": ["active", "deprecated", "revoked"]}
  }
}
